<component name="ProjectRunConfigurationManager">
    <!-- Rebuild the image from the working tree and recreate only the app container; the database is
         untouched. -->
    <configuration default="false" name="Weather app (rebuild)" type="docker-deploy" factoryName="docker-compose.yml"
                   server-name="Docker">
        <deployment type="docker-compose.yml">
            <settings>
                <option name="commandLineOptions" value="--build"/>
                <option name="services">
                    <list>
                        <option value="app"/>
                    </list>
                </option>
                <option name="secondarySourceFiles">
                    <list>
                        <option value="compose.override.yaml"/>
                    </list>
                </option>
                <option name="sourceFilePath" value="compose.yaml"/>
                <option name="upForceRecreate" value="true"/>
                <option name="upRemoveOrphans" value="true"/>
            </settings>
        </deployment>
        <method v="2"/>
    </configuration>
</component>
