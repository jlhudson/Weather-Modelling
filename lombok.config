# Lombok is used everywhere it is practical (D-140). @Qualifier has to be copied from the field onto
# the constructor parameter Lombok generates, or @RequiredArgsConstructor cannot be used on a bean
# that needs one.
#
# @Value is deliberately NOT copied. It would be injected twice - once through the generated
# constructor and once by reflection into the final field, which the JDK warns about today and will
# block in a future release. A bean that needs an environment value writes its own constructor.
config.stopBubbling = true
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.addLombokGeneratedAnnotation = true
