# Read by The-Hub-Database/env/make-env.sh, which writes .env.development and .env.production from it.
# Never put a secret here: {{...}} says where each value comes from (make-env.sh lists the forms).
# app: WEATHER
POSTGRES_DB=weather
POSTGRES_USER=weather
POSTGRES_PASSWORD={{db change-me}}
TUNNEL_TOKEN={{tunnel}}
WEATHER_CONSOLE_CODE={{admin}}
WEATHER_KEY_HUB={{key HUB_TO_WEATHER}}
WEATHER_HUB_URL={{http://host.docker.internal:8080 | http://hub-app:8080}}
WEATHER_HUB_API_KEY={{key WEATHER_TO_HUB}}
GOOGLE_WEATHER_KEY={{secret GOOGLE_WEATHER_KEY}}
CARTO_API_KEY={{secret CARTO_API_KEY}}
