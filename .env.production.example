# Weather's production values. Copy this file to ~/cranklyradix-env/prod/weather.env, fill every blank,
# and load it into the `weather` Portainer stack (Environment variables -> Load variables from .env file);
# keep the filled copy in your password manager and never in a repository.
# The-Hub-Database/docs/production/setup.md walks through it; .env.development.example explains each name.
#
# Every blank line is yours to fill. Compose itself refuses to start while the console code is blank; the
# production profile refuses while a secret is blank, a default, or a dev-key-… value from
# .env.development.example, and names it in the log.
SPRING_PROFILES_ACTIVE=production

# The database: the server's shared postgis stack (The-Hub-Database/docker/postgis). COMPOSE_PROFILES stays
# empty, so this stack starts no database of its own. POSTGRES_PASSWORD is the WEATHER_DB_PASSWORD that
# stack was given: one `openssl rand -hex 24`, the same value in both files.
COMPOSE_PROFILES=
WEATHER_DB_HOST=postgis
POSTGRES_DB=weather
POSTGRES_USER=weather
POSTGRES_PASSWORD=

# Console login: one user, 8 digits of your own.
WEATHER_CONSOLE_CODE=

# Comma-separated browser origins allowed to call the API. Usually empty. Never *.
WEATHER_CORS_ORIGINS=

# The key this service accepts from the Hub: one `openssl rand -hex 24`, the same value as the Hub's
# HUB_WEATHER_API_KEY in hub.env.
WEATHER_KEY_HUB=

# Who is running this deployment, sent to the Bureau, Open-Meteo, Google and the CFS in the User-Agent.
WEATHER_CONTACT=https://github.com/jlhudson/Weather-Modelling

# Google Maps Platform Weather API: the overflow when Open-Meteo is out of allowance, and the only upstream
# that bills. Optional.
GOOGLE_WEATHER_KEY=

# CARTO basemaps for the console map. Optional.
CARTO_API_KEY=

# Where the application answers: this server's Tailscale address (`tailscale ip -4`; the bootstrap printed
# it), so the other servers and Uptime Kuma reach it and nothing else does. Left blank it falls back to
# 127.0.0.1, which nothing outside this machine can reach.
WEATHER_BIND=
WEATHER_PORT=8082
WEATHER_MEM_LIMIT=1g

# Logs as structured JSON (ecs) in the container.
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# The image: what CI pushed to ghcr.io. main follows the branch and Watchtower keeps it current; a commit's
# full sha pins that build, which is the rollback, and Watchtower leaves it alone.
IMAGE_TAG=main
TZ=UTC

# A stack running alone on a server, with no shared postgis (The-Hub-Database/docs/production/move-a-stack.md
# §2): set COMPOSE_PROFILES=owndb, WEATHER_DB_HOST= (empty), and add the BACKUP_* and RCLONE_CONFIG_R2_* lines
# from .env.development.example.
