# The development values: `cp .env.development.example .env` and the stack runs on this machine as
# copied, beside the other checkouts. compose.yaml reads every line below. A server takes
# .env.production.example instead: the same names, set for the production profile and the shared PostGIS.

# The two profiles. development on your own machine, which is what this file is set for: the readable
# log pattern and the defaults below allowed. production on a server: JSON logs, and the application
# refuses to start while a secret is blank, left at a value below, or still a dev-key-….
SPRING_PROFILES_ACTIVE=development

# The database. owndb starts this stack's own PostGIS; on a server that runs the shared postgis stack,
# leave COMPOSE_PROFILES empty and set WEATHER_DB_HOST=postgis, with POSTGRES_PASSWORD the
# WEATHER_DB_PASSWORD that stack was given. `openssl rand -hex 24` makes a password; it takes effect
# when the volume is first made.
COMPOSE_PROFILES=owndb
WEATHER_DB_HOST=
POSTGRES_DB=weather
POSTGRES_USER=weather
POSTGRES_PASSWORD=change-me

# Console login: one user, an 8-digit code, lockout on consecutive failures
WEATHER_CONSOLE_CODE=12345678

# Comma-separated browser origins allowed to call the API. Never *.
WEATHER_CORS_ORIGINS=

# The key this service accepts from the Hub, pre-shared: any long random string (`openssl rand -hex 24`),
# the same value in the Hub's .env as HUB_WEATHER_API_KEY. It becomes consumer `hub`'s key on start, with
# every scope. Blank: only a key issued on /console/api-keys lets the Hub in. The dev-key-… value
# matches the Hub's .env.development.example; production refuses it.
WEATHER_KEY_HUB=dev-key-weather-hub-00000000000

# Who is running this deployment: sent to the Bureau, Open-Meteo, Google and the CFS in the User-Agent.
# The Bureau asks for a contact in the request; an email address or a URL.
WEATHER_CONTACT=https://github.com/jlhudson/Weather-Modelling

# Google Maps Platform Weather API: the overflow when Open-Meteo is out of allowance or not answering,
# and the only upstream that bills. Optional.
GOOGLE_WEATHER_KEY=

# CARTO basemaps for the console map. Optional.
CARTO_API_KEY=

# Where the application answers on this machine: 127.0.0.1 on your own; on a server, its Tailscale
# address (tailscale ip -4). The database's port stays on loopback. The memory ceiling: the JVM heap is
# 75% of it. 8082 is also IncidentWatch's port inside its container; that stack publishes on 8083.
WEATHER_BIND=127.0.0.1
WEATHER_PORT=8082
WEATHER_DB_PORT=5435
WEATHER_MEM_LIMIT=1g

# Logs as structured JSON (ecs) in the container, or empty for the plain pattern.
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# The nightly backup under owndb. Kept on the weather-backups volume for BACKUP_KEEP_DAYS, and copied off
# the box when BACKUP_RCLONE_REMOTE names an rclone remote. For Cloudflare R2 (or any S3-compatible
# store) fill the RCLONE_CONFIG_R2_* lines and set BACKUP_RCLONE_REMOTE=r2:<bucket>/weather.
# BACKUP_RUN_NOW=1 takes one backup as soon as the stack starts, so there is one from the first day.
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=14
BACKUP_RUN_NOW=1
BACKUP_RCLONE_REMOTE=
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=

# The image. A server pulls what CI tested and pushed to ghcr.io, and Watchtower replaces the container
# when a newer one lands; a development machine builds from this checkout through compose.override.yaml,
# whatever this says. IMAGE_TAG: main follows the branch; a commit's full sha pins that build, which is
# the rollback.
IMAGE_TAG=main

# Container timezone. Explicit: a container quietly inheriting Adelaide local time is the last thing
# a weather service needs.
TZ=UTC
