# Copy to .env. One file, one environment. Never commit .env.
POSTGRES_DB=weather
POSTGRES_USER=weather
POSTGRES_PASSWORD=change-me
# Console login: one user, an 8-digit code, lockout on consecutive failures
WEATHER_CONSOLE_CODE=12345678
# Comma-separated browser origins allowed to call the API. Never *.
WEATHER_CORS_ORIGINS=
# Identifies this deployment to MET Norway (blocks unidentified callers) and is polite elsewhere
WEATHER_CONTACT=https://github.com/jlhudson/Weather-Modelling
# Google Maps Platform Weather API — last in the provider order and the only one that bills. Optional.
GOOGLE_WEATHER_KEY=
# CARTO basemaps for the console map. Optional.
CARTO_API_KEY=
# Cloudflare Tunnel token, if this service is published on its own hostname. Optional.
CLOUDFLARE_TUNNEL_TOKEN=
TZ=UTC
