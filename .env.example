# Copy to .env. One file, one environment. Never commit .env. compose.yaml reads every line below; in
# Portainer the same names are the stack's environment variables
# (The-Hub-Database/docs/28-deployment.md) and this file is what to paste there.

# prod on a server: the application refuses to start while WEATHER_CONSOLE_CODE or POSTGRES_PASSWORD
# is blank or left at the value below, and logs as JSON. Empty for a development machine.
SPRING_PROFILES_ACTIVE=prod

# Postgres. Reachable on this machine's loopback only, so the password guards the compose network.
POSTGRES_DB=weather
POSTGRES_USER=weather
POSTGRES_PASSWORD=change-me

# Console login: one user, an 8-digit code, lockout on consecutive failures
WEATHER_CONSOLE_CODE=12345678

# Comma-separated browser origins allowed to call the API. Never *.
WEATHER_CORS_ORIGINS=

# Who is running this deployment: sent to the Bureau, Open-Meteo, Google and the CFS in the User-Agent.
# The Bureau asks for a contact in the request; an email address or a URL.
WEATHER_CONTACT=https://github.com/jlhudson/Weather-Modelling

# Google Maps Platform Weather API: the overflow when Open-Meteo is out of allowance or not answering,
# and the only upstream that bills. Optional.
GOOGLE_WEATHER_KEY=

# CARTO basemaps for the console map. Optional.
CARTO_API_KEY=

# Ports on this machine's loopback, and the application's memory ceiling (the JVM heap is 75% of it).
# 8082 is also IncidentWatch's port inside its container; that stack publishes on 8083.
WEATHER_PORT=8082
WEATHER_DB_PORT=5435
WEATHER_MEM_LIMIT=1g

# Logs as structured JSON (ecs) in the container, or empty for the plain pattern.
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# The nightly backup. Kept on the weather-backups volume for BACKUP_KEEP_DAYS, and copied off the
# box when BACKUP_RCLONE_REMOTE names an rclone remote. For Cloudflare R2 (or any S3-compatible
# store) fill the RCLONE_CONFIG_R2_* lines and set BACKUP_RCLONE_REMOTE=r2:<bucket>/weather.
# BACKUP_RUN_NOW=1 takes one backup as soon as the stack starts, so there is one from the first day.
# On AWS, an S3 remote (RCLONE_CONFIG_R2_PROVIDER=AWS) works the same.
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=14
BACKUP_RUN_NOW=1
BACKUP_RCLONE_REMOTE=
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=

# The edge. `edge` starts cloudflared, which needs the token; empty leaves the service on localhost.
COMPOSE_PROFILES=

# Cloudflare Tunnel, one per stack (D-255): create it at one.dash.cloudflare.com -> Networks ->
# Tunnels, choose Cloudflared, and copy the token out of the install command it shows. Then add a
# published application route on that tunnel: type HTTP, URL app:8082, path LEFT EMPTY. The console
# behind it is one 8-digit code against the whole internet: put Cloudflare Access in front of the
# hostname unless you mean it to be open, leaving /api/** to the keys.
CLOUDFLARE_TUNNEL_TOKEN=

# Container timezone. Explicit: a container quietly inheriting Adelaide local time is the last thing
# a weather service needs.
TZ=UTC
